# Somente variáveis do Next. NÃO coloque PORT aqui.
# Vazio = same-origin via rewrite do Next (recomendado para celular na LAN).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Samuel
# Chave raster CARTO Basemaps (e-mail carto.com/basemaps/apikey). Não versione o valor real.
# Sem ela o mapa carrega com watermark "API KEY REQUIRED".
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=
